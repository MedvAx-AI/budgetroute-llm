*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Environments and local configuration
.worktrees/
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging
build/
dist/
*.egg-info/
*.egg

# IDEs and operating systems
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db

